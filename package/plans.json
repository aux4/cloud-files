{
  "schemaVersion": 1,
  "metrics": {
    "storage-bytes": {
      "label": "Cloud file storage per user",
      "type": "gauge",
      "unit": {
        "base": "byte",
        "display": "GB",
        "baseUnitsPerDisplayUnit": 1000000000,
        "decimals": 2
      }
    }
  },
  "plans": {
    "small": {
      "price": {
        "monthly": 1
      },
      "limits": {
        "storage-bytes": 10
      }
    },
    "medium": {
      "price": {
        "monthly": 5
      },
      "limits": {
        "storage-bytes": 50
      }
    },
    "large": {
      "price": {
        "monthly": 10
      },
      "limits": {
        "storage-bytes": 100
      }
    }
  }
}
