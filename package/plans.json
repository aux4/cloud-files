{
  "schemaVersion": 1,
  "metrics": {
    "storage-bytes": {
      "label": "Cloud Files storage for the scope",
      "type": "gauge",
      "unit": {
        "base": "byte",
        "display": "GB",
        "baseUnitsPerDisplayUnit": 1000000000,
        "decimals": 2
      }
    }
  },
  "plans": {
    "usage": {
      "price": {
        "metered": {
          "unit": "gb-month",
          "microCentsPerUnit": 10000000,
          "includedBytes": 1000000000
        }
      },
      "limits": {
        "storage-bytes": -1
      }
    }
  }
}
