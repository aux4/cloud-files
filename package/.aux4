{
  "scope": "aux4",
  "name": "cloud-files",
  "version": "0.1.20",
  "type": "cloud",
  "cloud": {
    "deployment": "new-vm",
    "machine": {
      "name": "files",
      "size": "sm",
      "disk": 1,
      "type": "api",
      "tenantCapabilities": {
        "packages": false,
        "webhooks": false
      }
    }
  },
  "description": "Per-user file storage for aux4 Cloud applications",
  "license": "Apache-2.0",
  "tags": [
    "cloud",
    "files",
    "storage"
  ],
  "dependencies": [
    "aux4/cloud@1.2.12",
    "aux4/platform@1.3.59"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "list",
          "execute": [
            "aux4 aux4 cloud files list --package files values(scope, path, apiUrl)"
          ],
          "help": {
            "text": "List files in a cloud VM",
            "variables": [
              {
                "name": "scope",
                "text": "Scope",
                "env": "AUX4_CLOUD_SCOPE",
                "private": true
              },
              {
                "name": "path",
                "text": "Directory path",
                "default": ""
              },
              {
                "name": "apiUrl",
                "text": "Cloud API base URL",
                "env": "AUX4_CLOUD_API_URL",
                "default": "https://api.aux4.cloud",
                "private": true
              }
            ]
          }
        },
        {
          "name": "get",
          "execute": [
            "aux4 aux4 cloud files get --package files values(scope, path, apiUrl)"
          ],
          "help": {
            "text": "Read a text file from a cloud VM",
            "variables": [
              {
                "name": "scope",
                "text": "Scope",
                "env": "AUX4_CLOUD_SCOPE",
                "private": true
              },
              {
                "name": "path",
                "text": "File path",
                "arg": true
              },
              {
                "name": "apiUrl",
                "text": "Cloud API base URL",
                "env": "AUX4_CLOUD_API_URL",
                "default": "https://api.aux4.cloud",
                "private": true
              }
            ]
          }
        },
        {
          "name": "upload",
          "execute": [
            "stdin:aux4 aux4 cloud files upload --package files values(scope, path, file, retention, apiUrl)"
          ],
          "help": {
            "text": "Upload or replace a file in a cloud VM",
            "variables": [
              {
                "name": "scope",
                "text": "Scope",
                "env": "AUX4_CLOUD_SCOPE",
                "private": true
              },
              {
                "name": "path",
                "text": "Remote file path"
              },
              {
                "name": "file",
                "text": "Local file path",
                "default": ""
              },
              {
                "name": "retention",
                "text": "Retention in days (0 = never expire)",
                "default": "30"
              },
              {
                "name": "apiUrl",
                "text": "Cloud API base URL",
                "env": "AUX4_CLOUD_API_URL",
                "default": "https://api.aux4.cloud",
                "private": true
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "confirm:Are you sure you want to delete this file?",
            "aux4 aux4 cloud files delete --package files values(scope, path, apiUrl)"
          ],
          "help": {
            "text": "Delete a file from a cloud VM",
            "variables": [
              {
                "name": "scope",
                "text": "Scope",
                "env": "AUX4_CLOUD_SCOPE",
                "private": true
              },
              {
                "name": "path",
                "text": "File path"
              },
              {
                "name": "apiUrl",
                "text": "Cloud API base URL",
                "env": "AUX4_CLOUD_API_URL",
                "default": "https://api.aux4.cloud",
                "private": true
              }
            ]
          }
        }
      ]
    },
    {
      "name": "platform:app",
      "commands": [
        {
          "name": "files",
          "execute": [
            "profile:platform:app:files"
          ],
          "help": {
            "text": "Browse your aux4 Cloud files"
          }
        }
      ]
    },
    {
      "name": "platform:app:files",
      "commands": [
        {
          "name": "meta",
          "execute": [
            "node ${packageDir}/lib/cloud-files-app.mjs meta value(appFile)"
          ],
          "help": {
            "text": "Return the Files app metadata",
            "variables": [
              {
                "name": "appFile",
                "text": "Bundled app descriptor",
                "default": "${packageDir}/app.json",
                "private": true
              }
            ]
          }
        },
        {
          "name": "ui",
          "execute": [
            "node ${packageDir}/lib/cloud-files-app.mjs ui value(appFile)"
          ],
          "help": {
            "text": "Return the Files app routes",
            "variables": [
              {
                "name": "appFile",
                "text": "Bundled app descriptor",
                "default": "${packageDir}/app.json",
                "private": true
              }
            ]
          }
        },
        {
          "name": "browse",
          "execute": [
            "set:path=nvl(body.path, path, '')",
            "node ${packageDir}/lib/cloud-files-app.mjs browse value(path)"
          ],
          "help": {
            "text": "List the signed-in user's files and folders",
            "variables": [
              {
                "name": "body",
                "text": "Request body",
                "default": "{}",
                "private": true
              },
              {
                "name": "path",
                "text": "Folder path",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "create-folder",
          "execute": [
            "set:path=nvl(body.path, path, '')",
            "set:name=nvl(body.name, name, '')",
            "node ${packageDir}/lib/cloud-files-app.mjs create-folder values(path, name)"
          ],
          "help": {
            "text": "Create a folder for the signed-in user",
            "variables": [
              {
                "name": "body",
                "text": "Request body",
                "default": "{}",
                "private": true
              },
              {
                "name": "path",
                "text": "Parent folder",
                "default": ""
              },
              {
                "name": "name",
                "text": "Folder name"
              }
            ]
          }
        },
        {
          "name": "upload",
          "execute": [
            "set:path=nvl(body.path, path, '')",
            "set:files=nvl(body.file, files, '[]')",
            "node ${packageDir}/lib/cloud-files-app.mjs upload values(path, files)"
          ],
          "help": {
            "text": "Upload files into the signed-in user's current folder",
            "variables": [
              {
                "name": "body",
                "text": "Multipart request body",
                "default": "{}",
                "private": true
              },
              {
                "name": "path",
                "text": "Target folder",
                "default": ""
              },
              {
                "name": "files",
                "text": "Uploaded file parts",
                "default": "[]",
                "private": true
              }
            ]
          }
        },
        {
          "name": "delete",
          "execute": [
            "set:path=nvl(body.path, path, '')",
            "node ${packageDir}/lib/cloud-files-app.mjs delete value(path)"
          ],
          "help": {
            "text": "Delete a file owned by the signed-in user",
            "variables": [
              {
                "name": "body",
                "text": "Request body",
                "default": "{}",
                "private": true
              },
              {
                "name": "path",
                "text": "File path"
              }
            ]
          }
        }
      ]
    }
  ]
}
