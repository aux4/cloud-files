{
  "name": "Files",
  "title": "Cloud Files",
  "icon": "folder",
  "components": "static/cloud-files.js",
  "api": [
    { "action": "browse", "method": "POST", "path": "/browse", "command": "browse" },
    { "action": "create-folder", "method": "POST", "path": "/folders", "command": "create-folder" },
    { "action": "upload", "method": "POST", "path": "/upload", "command": "upload" },
    { "action": "delete", "method": "POST", "path": "/delete", "command": "delete" }
  ],
  "routes": {
    "/": {
      "type": "Page",
      "props": {
        "documentTitle": "Cloud Files",
        "layout": "workspace"
      },
      "children": [
        {
          "type": "CloudFilesBrowser",
          "props": {}
        }
      ]
    }
  }
}
